1:[["$","section",null,{"id":"about","className":"about-section","children":[["$","header",null,{"className":"post-header","children":[["$","h1",null,{"className":"post-title","children":[["$","span",null,{"children":"Vincent"}]," Meijer"]}],["$","p",null,{"className":"post-description","children":["Assistant Professor"," at"," ",["$","a",null,{"href":"https://www.tudelft.nl/en/ae","target":"_blank","rel":"noreferrer","children":"TU Delft"}]," ","working on aviation environmental impacts and remote sensing."]}]]}],["$","div",null,{"className":"about-grid","children":[["$","div",null,{"className":"about-copy","children":[["$","p",null,{"children":"I study contrails and other non-CO₂ effects of aviation, with an emphasis on comparing model predictions with what we can actually observe. I completed my PhD at MIT in 2024 on satellite-based contrail analysis and forecast evaluation, after which I joined the Faculty of Aerospace Engineering at the TU Delft as an assistant professor."}],["$","p",null,{"children":"In my research group, we develop methods to detect, track and attribute contrails in satellite imagery, estimate their physical properties, and use this data to evaluate predictions made using weather and climate models. Ultimately, we are interested in better enabling the mitigation of aviation's negative effects on the environment through acquiring high-quality observational data and using this to improve the models that we use in decision-making."}]]}],["$","aside",null,{"className":"profile","aria-label":"Profile details","children":[["$","img",null,{"src":"/vincent_meijer.webp","alt":"Vincent Meijer","width":301,"height":301,"loading":"eager","fetchPriority":"high","className":"profile-image"}],["$","div",null,{"className":"more-info","children":[["$","p",null,{"children":"Aerospace Engineering"}],["$","p",null,{"children":"TU Delft"}],["$","p",null,{"className":"location-line","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 10c0